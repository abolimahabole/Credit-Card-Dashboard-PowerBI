table Customers
	lineageTag: 39880ad5-95b8-4251-92fb-ac19ec42ec89

	measure 'Revenue Per Customers' = DIVIDE(Credit_Card[Total Revenue],DISTINCTCOUNT(Credit_Card[Client_Num]))
		lineageTag: 7d1325cd-a990-4697-84ef-6c7783b8332a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Customers = DISTINCTCOUNT(Customers[Client_Num])
		formatString: 0
		lineageTag: 6acb2187-186e-4cb2-8a90-6b02886b94b2

	measure 'Top 10 Customer Revenue' =
			
			CALCULATE([Total Revenue],TOPN(10,
			VALUES(Customers[Client_Num]),
			[Total Revenue],
			DESC))
		lineageTag: c567874b-08fd-480e-8b54-09d3790ae6a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

