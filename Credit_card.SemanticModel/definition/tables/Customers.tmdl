	column Age_Group = ```
			SWITCH(TRUE(),
			Customers[Customer_Age]<30,"20-30",
			Customers[Customer_Age]>=30 && Customers[Customer_Age]<40,"30-40",
			Customers[Customer_Age]>=40 && Customers[Customer_Age]<50,"40-50",
			Customers[Customer_Age]>=50 && Customers[Customer_Age]<60,"50-60",
			Customers[Customer_Age]>=60,"60+",
			"Unknown"
			)
			
			```
		lineageTag: deca7a18-3237-4a01-b440-12f23fe53472
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Income_Group =
			SWITCH(TRUE(),
			Customers[Income]<35000,"Low",
			Customers[Income]>=35000 && Customers[Income]<70000,"Medium",
			Customers[Income]>=70000,"High",
			"Unknown"
			)
		lineageTag: d35cc3bb-c968-441b-8f75-3cfbdd30df5d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Customers = m
		mode: import
		source =
				let
				    Source = MySQL.Database("127.0.0.1", "credit_card_project", [ReturnSingleDatabase=true, Query="select * from cust_info"])
				in
				    Source

	annotation PBI_ResultType = Table

