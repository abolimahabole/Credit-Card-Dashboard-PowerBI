table Credit_Card
	lineageTag: 37477cca-34e9-47fe-8455-6261cdebfb67

	measure 'Previous Week Revenue' = ```
			
			VAR currentWeek =
			MAX(Credit_Card[Week_Num])
			RETURN
			CALCULATE(
			    [Total Revenue],
			    Credit_Card[WeekNum]
			    
			
			)
			```
		lineageTag: 4e8e8fb2-5a55-4998-b823-81e1010e5aa8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue' = ```
			SUM(Credit_Card[Revenue])
			
			```
		lineageTag: b0e08ef7-4cae-4ec2-9aae-89712238059a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

